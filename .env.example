# Copy to .env and fill in. .env is git-ignored; never commit real keys.
DOCUMIND_DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
DOCUMIND_STORAGE_DIR=data/store

# OCR (tesseract language models)
DOCUMIND_OCR_LANGS=uzb+uzb_cyrl+rus
DOCUMIND_OCR_DPI=300
DOCUMIND_OCR_MIN_TEXT_CHARS=30

# Chunking
DOCUMIND_CHUNK_MAX_WORDS=180

# Train/test split by document
DOCUMIND_TEST_FRACTION=0.3

# LLM (used from stage 3). Key is read from env only.
DOCUMIND_LLM_API_KEY=
DOCUMIND_LLM_MODEL=
DOCUMIND_LLM_MAX_TOKENS_PER_REQUEST=800
DOCUMIND_LLM_MONTHLY_BUDGET_USD=5.0
