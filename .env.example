# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# The same file is read by `documind` (local development) and by docker-compose.yml; in
# Docker the database and Qdrant URLs below are replaced by the ones in docker-compose.yml.
DOCUMIND_DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
DOCUMIND_STORAGE_DIR=data/store

# OCR (tesseract language models)
DOCUMIND_OCR_LANGS=uzb+uzb_cyrl+rus
DOCUMIND_OCR_DPI=300
DOCUMIND_OCR_MIN_TEXT_CHARS=30

# Chunking
DOCUMIND_CHUNK_MAX_WORDS=180

# Train/test split by document
DOCUMIND_TEST_FRACTION=0.3

# API (stage 3). extractive = quotes only, no LLM key needed (default).
DOCUMIND_ANSWER_MODE=extractive
DOCUMIND_API_RETRIEVER=bm25
DOCUMIND_API_TOP_K=3
DOCUMIND_QUOTE_MAX_SENTENCES=2

# Uploads: separate database and storage for the "user" corpus (never the eval corpora)
DOCUMIND_USER_DATABASE_URL=sqlite:///documind_user.sqlite
DOCUMIND_USER_STORAGE_DIR=data/user_store
DOCUMIND_UPLOAD_MAX_BYTES=20971520
DOCUMIND_UPLOAD_MAX_PAGES=50
DOCUMIND_UPLOAD_MAX_PIXELS=40000000

# Public demo: upload endpoint answers 403, no user corpus, main database read-only
DOCUMIND_PUBLIC_DEMO=false

# LLM (only with DOCUMIND_ANSWER_MODE=llm). Key is read from env only.
# Provider: "package.module:factory", returns an object with complete(prompt, max_tokens).
DOCUMIND_LLM_PROVIDER=
DOCUMIND_LLM_API_KEY=
DOCUMIND_LLM_MODEL=
DOCUMIND_LLM_MAX_TOKENS_PER_REQUEST=800
DOCUMIND_LLM_MONTHLY_BUDGET_USD=5.0

# Retrieval (stage 2)
DOCUMIND_EMBED_MODEL_DIR=models/multilingual-e5-small
DOCUMIND_QDRANT_URL=
DOCUMIND_BM25_ANALYZER=fold+stem6
DOCUMIND_RRF_K=60

# --- docker-compose.yml only (see docs/deploy.md) ---------------------------------------
# Passwords: long random strings, e.g. `openssl rand -hex 24`. Used when the PostgreSQL
# volume is first created; changing them later needs ALTER ROLE.
POSTGRES_PASSWORD=
DOCUMIND_API_DB_PASSWORD=
# ":80" = plain HTTP (local). A domain name = HTTPS with a Let's Encrypt certificate;
# then also WEB_BIND=0.0.0.0, WEB_HTTP_PORT=80, WEB_HTTPS_PORT=443.
SITE_ADDRESS=:80
WEB_BIND=127.0.0.1
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
# Per client IP, enforced by Caddy (429 when exceeded)
RATE_LIMIT_ASK_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_ALL_PER_MINUTE=300
