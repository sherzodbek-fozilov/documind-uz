__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.env
# raw and generated documents are never committed (licenses / size); see docs/data.md
data/raw/*
!data/raw/.gitkeep
# the manifest (ids, URLs, licenses, sha256) is committed; the documents are not
!data/raw/manifest.jsonl
data/synthetic/*
!data/synthetic/README.md
data/store/
# uploaded documents (user corpus)
data/user_store/
*.sqlite
node_modules/
# downloaded model weights
models/
# embedding cache
data/cache/
# question drafts under review (working files)
data/eval/drafts/
# fine-tuning pairs contain lex.uz text, which is not redistributed; see docs/decisions.md
data/training/
# fine-tuned model checkpoints and exports
runs/
